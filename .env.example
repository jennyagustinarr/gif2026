# Salin file ini jadi `.env.local` lalu sesuaikan nilainya.
# `.env.local` sengaja diabaikan git supaya kredensial tidak ikut ter-push.

# =====================================================================
#  DATABASE
#  Pilih SALAH SATU cara di bawah ini.
# =====================================================================

# --- Cara 1: XAMPP di komputer sendiri (development) ------------------
# Nilai di bawah ini sudah cocok dengan XAMPP standar (root tanpa password).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=green_impact_festival

# --- Cara 2: MySQL cloud (produksi, mis. Railway / Aiven) -------------
# Kalau diisi, DATABASE_URL menang atas kelima variabel di atas.
# Format: mysql://user:password@host:3306/nama_database
# DATABASE_URL=

# Setelan TLS/SSL untuk database cloud:
#   kosong / false -> tanpa SSL (untuk XAMPP lokal)
#   true           -> SSL dengan verifikasi sertifikat
#   insecure       -> SSL tanpa verifikasi (kalau penyedia belum memberi CA)
DB_SSL=

# =====================================================================
#  SITUS
# =====================================================================

# Base URL untuk metadata dan Open Graph.
# Saat deploy, ganti jadi domain aslinya, mis. https://gif2026.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
