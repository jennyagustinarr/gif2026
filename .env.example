# Salin file ini jadi `.env.local` lalu sesuaikan nilainya.
# `.env.local` sengaja diabaikan git supaya kredensial tidak ikut ter-push.

# --- Database MySQL (XAMPP) ------------------------------------------
# Nilai di bawah ini sudah cocok dengan XAMPP standar (root tanpa password).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=green_impact_festival

# --- Situs ------------------------------------------------------------
# Base URL untuk metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
