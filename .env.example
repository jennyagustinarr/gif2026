# Salin file ini jadi `.env.local` lalu isi nilainya.

# URL endpoint tujuan pendaftaran (mis. Google Apps Script Web App, n8n, Zapier,
# atau API internal). Kalau dikosongkan, API route hanya melakukan logging
# ke server console dan tetap mengembalikan status sukses.
REGISTRATION_WEBHOOK_URL=

# Base URL situs untuk metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
